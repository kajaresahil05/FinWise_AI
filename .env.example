# Flask Setup
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace_with_a_secure_random_key_in_production
JWT_SECRET_KEY=replace_with_a_secure_jwt_secret_key_in_production
PORT=5000

# Database Configuration (Docker default)
DB_USER=finwise_user
DB_PASSWORD=finwise_password
DB_NAME=finwise_db
DB_HOST=db
DB_PORT=5432
# If running Flask locally outside Docker: DATABASE_URL=postgresql://finwise_user:finwise_password@localhost:5432/finwise_db
DATABASE_URL=postgresql://finwise_user:finwise_password@db:5432/finwise_db

# AI Provider Configuration
# Supported options: 'ollama', 'openai', 'gemini'
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=

# OCR Config (Optional)
TESSERACT_CMD=
